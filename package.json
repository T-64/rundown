{
  "name": "pi-rundown",
  "version": "0.1.0",
  "description": "A daily audio briefing for your agent: gathers weather and headlines, voices the script locally, and saves the episode to your Spotify library with Save to Spotify.",
  "type": "module",
  "license": "MIT",
  "author": "Zhaoqing Tan",
  "keywords": ["pi-package", "pi", "agent", "podcast", "tts", "briefing"],
  "repository": { "type": "git", "url": "git+https://github.com/T-64/pi-rundown.git" },
  "engines": { "node": ">=22.18" },
  "bin": { "rundown": "./src/cli.ts" },
  "pi": {
    "extensions": ["./src/pi/extension.ts"],
    "prompts": ["./prompts/*.md"]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "demo": "node src/cli.ts produce examples/script.json --dry-run"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
